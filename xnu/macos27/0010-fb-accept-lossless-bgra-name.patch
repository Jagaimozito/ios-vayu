 #define SWEET_FB_FORMAT_BGRA            0x42475241
+/*
+ * macOS 27: WindowServer's framebuffer surface is '&BGA' (0x26424741, CoreVideo's lossless-compressed BGRA name),
+ * 828x1792, 4 bytes a pixel, rows of 3328 bytes: a linear layout. Our IOSurface and the Metal plugin implement no
+ * Apple compression, so what Turnip renders into it is plain BGRA. Only the GPU blit (which waits for the frame's GPU
+ * work) accepted 'BGRA'; '&BGA' fell back to the CPU copy and the panel showed blocky garbage (2026-11-21; whether the
+ * CPU copy read it before the GPU's writes or the contents are not linear is what this test tells). On macOS the GPU
+ * path takes both.
+ */
+static inline bool
+sweet_fb_gpu_bgra(uint32_t format)
+{
+#if XNU_TARGET_OS_OSX
+	return format == SWEET_FB_FORMAT_BGRA || format == 0x26424741u;
+#else
+	return format == SWEET_FB_FORMAT_BGRA;
+#endif
+}
 
