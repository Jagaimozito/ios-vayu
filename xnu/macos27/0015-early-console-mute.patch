diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -628,6 +628,16 @@ AppleCLCD::start(IOService *provider)
 		return false;
 	}
+#if XNU_TARGET_OS_OSX
+	/* Some macOS startup paths never call our synthetic IOMobileFramebuffer swap methods.
+	 * Allow an explicit boot-arg to mute and clear the boot console as soon as scanout is ready,
