+	uint32_t noConsole = 0;
+	if (PE_parse_boot_argn("sweetfb_noconsole", &noConsole, sizeof(noConsole)) && noConsole != 0) {
+		pauseConsole();
+	}
+#endif
 	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
