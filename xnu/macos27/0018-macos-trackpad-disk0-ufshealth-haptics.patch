+/*
+ * macOS (2026-11-22): the UFS device's Health Descriptor (JESD220 IDN 0x09), read once at start with a QUERY
+ * REQUEST UPIU in slot 0: pre-EOL information and the two life-time estimates (wear). Read only; nothing is
+ * written to the device. sysctl kern.sweet_ufs_health shows it.
+ */
+static char sweet_ufs_health[128] = "not read";
+SYSCTL_STRING(_kern, OID_AUTO, sweet_ufs_health, CTLFLAG_RD | CTLFLAG_LOCKED, sweet_ufs_health, 0,
+    "UFS Health Descriptor: pre-EOL info, life time estimate A/B");
+
+static void
+ufs_query_health(void)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	const uint16_t want = 0x2c;             /* the descriptor's size; the device returns what it has */
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x16;                     /* QUERY REQUEST UPIU */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = 0x01;                     /* standard read request */
+	ucd->cmd[12] = 0x01;                    /* READ DESCRIPTOR */
+	ucd->cmd[13] = 0x09;                    /* Health Descriptor */
+	ucd->cmd[18] = (uint8_t)(want >> 8);
+	ucd->cmd[19] = (uint8_t)want;
+	utrd->dw0 = (1u << 28) | (1u << 24);    /* UFS storage, no data phase, interrupt */
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			snprintf(sweet_ufs_health, sizeof(sweet_ufs_health), "query timed out");
+			printf("SWEET UFS: health query timed out\n");
+			return;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	const uint8_t *r = ucd->resp, *d = ucd->resp + 32;
+	uint32_t ocs = utrd->dw2 & 0xff, seg = ((uint32_t)r[10] << 8) | r[11];
+	if (ocs || r[0] != 0x36 || r[6] != 0 || seg < 5 || d[1] != 0x09) {
+		snprintf(sweet_ufs_health, sizeof(sweet_ufs_health), "query failed: ocs 0x%x upiu 0x%x response 0x%x len %u idn 0x%x",
+		    ocs, r[0], r[6], seg, d[1]);
+		printf("SWEET UFS: health %s\n", sweet_ufs_health);
