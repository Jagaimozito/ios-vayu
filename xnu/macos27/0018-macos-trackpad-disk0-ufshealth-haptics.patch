+#if XNU_TARGET_OS_OSX
+/*
+ * macOS (2026-11-22): a short click for the touchscreen trackpad (SweetHID.cpp), waveform `wave` at gain `gain`
+ * (DATDBG), played from a thread call so the caller (the touch thread) never waits on the I2C. Clicks closer than
+ * 40 ms together, or while one is still being started, are dropped.
+ */
+#include <kern/thread_call.h>
+int sweet_haptic_tick(unsigned wave, unsigned gain);
+static thread_call_t hap_tick_call;
+static volatile uint32_t hap_tick_wave, hap_tick_gain, hap_tick_busy;
+static uint64_t hap_tick_last;
+
+static void
+hap_tick_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	if (hp.ready) {
+		hap_ensure("trackpad");
+		lck_mtx_lock(hp.lock);
+		(void)hap_play_gain((uint8_t)hap_tick_wave, 0, (uint8_t)hap_tick_gain);
+		lck_mtx_unlock(hp.lock);
+	}
+	__atomic_store_n(&hap_tick_busy, 0, __ATOMIC_RELEASE);
+}
+
+int
+sweet_haptic_tick(unsigned wave, unsigned gain)
+{
+	if (!hp.ready || wave == 0 || wave > 127 || gain == 0 || gain > 0x80) {
+		return ENODEV;
+	}
+	uint64_t now = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(now - hap_tick_last, &ns);
+	if (hap_tick_last != 0 && ns < 40 * NSEC_PER_MSEC) {
+		return EBUSY;
+	}
+	if (__atomic_exchange_n(&hap_tick_busy, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (hap_tick_call == NULL) {
+		hap_tick_call = thread_call_allocate_with_options(hap_tick_run, NULL, THREAD_CALL_PRIORITY_USER, 0);
+		if (hap_tick_call == NULL) {
+			__atomic_store_n(&hap_tick_busy, 0, __ATOMIC_RELEASE);
+			return ENOMEM;
+		}
+	}
+	hap_tick_last = now;
+	hap_tick_wave = wave;
+	hap_tick_gain = gain;
+	thread_call_enter(hap_tick_call);
+	return 0;
+}
+#else
+int sweet_haptic_tick(unsigned wave, unsigned gain);
+int
+sweet_haptic_tick(__unused unsigned wave, __unused unsigned gain)
+{
+	return ENODEV;
+}
+#endif
