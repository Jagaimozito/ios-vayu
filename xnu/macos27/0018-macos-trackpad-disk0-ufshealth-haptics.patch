+#if XNU_TARGET_OS_OSX
+/* Normalised panel position -> screen pixels << 8, turned as the screen is (sweetfb_rot). */
+void
+SweetHIDPointer::toScreen(IOFixed nx, IOFixed ny, int64_t *sx, int64_t *sy)
+{
+	static int rot = -1;
+	if (rot < 0) {
+		uint32_t r = 1;
+		(void)PE_parse_boot_argn("sweetfb_rot", &r, sizeof(r));
+		rot = (r == 0 || r == 3) ? (int)r : 1;
+	}
+	const IOFixed one = 0x10000;
+	IOFixed rx = nx, ry = ny;
+	if (rot == 1) {
+		rx = ny;
+		ry = one - nx;
+	} else if (rot == 3) {
+		rx = one - ny;
+		ry = nx;
+	}
+	*sx = ((int64_t)rx * fScreenW) >> 8;
+	*sy = ((int64_t)ry * fScreenH) >> 8;
+}
+
+void
+SweetHIDPointer::buttons(uint32_t b)
+{
+	IOHIDEvent *event = IOHIDEvent::relativePointerEvent(mach_absolute_time(), 0, 0, 0, b, fButtons);
+	if (event) {
+		dispatchEvent(event);
+		event->release();
+	}
+	fButtons = b;
+}
+
+/*
+ * 2026-11-22: a light click from the vibration motor for each trackpad click and drag start, as a MacBook's trackpad
+ * gives. The lightest tap waveform (2) at a low gain, played from a thread call (sweet_haptic.c) so the touch thread
+ * never waits on the motor's I2C. Boot-arg sweetpadhaptic=N sets the gain (0 = off; Android's strongest is 0x80).
+ */
+extern "C" int sweet_haptic_tick(unsigned wave, unsigned gain);
+
+/*
+ * Tunable while running: sysctl -w kern.sweet_pad_haptic_gain=N (0 = off .. 128) and kern.sweet_pad_haptic_wave=W
+ * (OnePlus RAM waveforms: 2 light, 5 medium, 20 heavy tap, 10 the buzz, played once here). Default: waveform 10 at
+ * 0x80, chosen on the phone (waveform 2 at 0x20 was too faint).
+ */
+SYSCTL_UINT(_kern, OID_AUTO, sweet_pad_haptic_gain, CTLFLAG_RW | CTLFLAG_LOCKED, &gPadTickGain, 0,
+    "trackpad click strength (0 off .. 128)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_pad_haptic_wave, CTLFLAG_RW | CTLFLAG_LOCKED, &gPadTickWave, 0,
+    "trackpad click waveform (2 light, 5 medium, 20 heavy)");
+
+void
+SweetHIDPointer::tick(void)
+{
+	unsigned g = gPadTickGain > 0x80 ? 0x80 : gPadTickGain;
+	if (g) {
+		(void)sweet_haptic_tick(gPadTickWave ? gPadTickWave : 10, g);
+	}
+}
+
+void
+SweetHIDPointer::pad(int count, const IOFixed *nx, const IOFixed *ny)
+{
+	const uint64_t now = mach_absolute_time();
+	uint64_t ns;
+	int64_t sx = 0, sy = 0;
+	if (count >= 2) {
+		int n = count >= 3 ? 3 : 2;
+		for (int i = 0; i < n; i++) {
+			int64_t ax, ay;
+			toScreen(nx[i], ny[i], &ax, &ay);
+			sx += ax;
+			sy += ay;
+		}
+		sx /= n;
+		sy /= n;
+	} else if (count == 1) {
+		toScreen(nx[0], ny[0], &sx, &sy);
+	}
+
+	if (fCount == 0 && count > 0) {
+		/* a gesture starts; a touch soon after a one-finger tap holds the button: tap-and-drag */
+		fStart = now;
+		fMaxCount = count;
+		fMoved = 0;
+		fScrolled = false;
+		fDrag3 = false;
+		absolutetime_to_nanoseconds(now - fLastTapEnd, &ns);
+		if (count == 1 && fLastTapEnd != 0 && ns < 300 * NSEC_PER_MSEC) {
+			fDragging = true;
+			buttons(1);
+			tick();
+		} else if (count >= 3) {
+			fDrag3 = true;          /* three fingers landed together */
+			buttons(1);
+			tick();
+		}
+		fLastX = sx;
+		fLastY = sy;
+	} else if (count > 0 && count != fCount) {
+		/* fingers added or lifted: restart the deltas from here, no jump */
+		fMaxCount = count > fMaxCount ? count : fMaxCount;
+		fLastX = sx;
+		fLastY = sy;
+		/* three fingers down: press and hold, so sliding drags (windows by the title bar, selections) */
+		if (count >= 3 && !fDrag3 && !fDragging) {
+			fDrag3 = true;
+			buttons(1);
+			tick();
+		} else if (count < 3 && fDrag3) {
+			fDrag3 = false;
+			fScrolled = true;       /* no tap when these fingers lift */
+			buttons(0);
+		}
+	} else if (count > 0) {
+		int64_t dx = sx - fLastX, dy = sy - fLastY;
+		fLastX = sx;
+		fLastY = sy;
+		fMoved += (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+		if (count == 1 || fDrag3) {
+			/* 1.5x the finger's travel; macOS adds its own acceleration */
+			fRemX += dx * 3 / 2;
+			fRemY += dy * 3 / 2;
+			SInt32 mx = (SInt32)(fRemX / 256), my = (SInt32)(fRemY / 256);
+			fRemX -= (int64_t)mx * 256;
+			fRemY -= (int64_t)my * 256;
+			if (mx || my) {
+				IOHIDEvent *event = IOHIDEvent::relativePointerEvent(now, mx, my, 0, fButtons, fButtons);
+				if (event) {
+					dispatchEvent(event);
+					event->release();
+				}
+			}
+		} else if (count == 2 && (dx || dy) && fMoved > (8 << 8)) {
+			/* content follows the fingers: one line per 10 pixels, in fixed point for smoothness */
+			fScrolled = true;
+			IOHIDEvent *event = IOHIDEvent::scrollEventWithFixed(now, (IOFixed)(dx * 256 / 10),
+			    (IOFixed)(dy * 256 / 10), 0);
+			if (event) {
+				dispatchEvent(event);
+				event->release();
+			}
+		}
+	}
+
+	if (fCount > 0 && count == 0) {
+		/* the gesture ends: a short one without travel is a tap */
+		absolutetime_to_nanoseconds(now - fStart, &ns);
+		bool tap = ns < 250 * NSEC_PER_MSEC && fMoved < (12 << 8) && !fScrolled;
+		if (fDrag3) {
+			buttons(0);
+			fDrag3 = false;
+			fLastTapEnd = 0;
+		} else if (fDragging) {
+			buttons(0);
+			fDragging = false;
+			fLastTapEnd = 0;
+		} else if (tap && fMaxCount == 1) {
+			buttons(1);
+			buttons(0);
+			tick();
+			fLastTapEnd = now;
+		} else if (tap && fMaxCount == 2) {
+			buttons(2);
+			buttons(0);
+			tick();
+			fLastTapEnd = 0;
+		} else {
+			fLastTapEnd = 0;
+		}
+		fRemX = fRemY = 0;
+	}
+	fCount = count;
+}
