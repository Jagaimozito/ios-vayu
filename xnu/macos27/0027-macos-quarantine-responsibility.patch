+/*
+ * 2026-11-23: responsibility. tccd builds an "attribution chain" for every TCC request from libquarantine's
+ * responsibility_* calls, which are __mac_syscall("Quarantine", 180..187) (research: outputs/libquarantine-
+ * responsibility.txt). The stand-in above answered them 0 without filling anything, so tccd got PID 0 back
+ * ("proc_pidpath_audittoken() failed from PID[0]", "failed to construct a process for the responsible audit token",
+ * "Failed to create attribution chain") and denied every request: the Accessibility Keyboard's key events ("Sender is
+ * prohibited from synthesizing events"), the nameless "Application" prompt, all TCC. Answered now; the responsible
+ * process is the one launchd/posix_spawn recorded (p_responsible_pid) when it is alive, else the process itself.
+ *   180 get        {pid, int32 *resp_pid, uint64 *resp_uniqueid, [get2 fields: refused]}
+ *   181 set        {pid, responsible pid}
+ *   182 get3       {pid, pidversion, audit_token_t *resp_token (token query) | 0 (attribution query), ...}
+ *   183-187        set audit-token / hosted path / team: accepted, nothing kept
+ */
+extern void proc_set_responsible_pid(proc_t target_proc, pid_t responsible_pid);
+
+static proc_t
+sweet_resp_find(pid_t pid, int64_t pidversion, bool check_version)
+{
+	proc_t t = proc_find(pid);
+	if (t == PROC_NULL) {
+		return PROC_NULL;
+	}
+	if (check_version && pidversion != 0 && proc_pidversion(t) != (int)pidversion) {
+		proc_rele(t);
+		return PROC_NULL;
+	}
+	pid_t rp = t->p_responsible_pid;
+	if (rp > 0 && rp != proc_pid(t)) {
+		proc_t r = proc_find(rp);
+		if (r != PROC_NULL) {
+			proc_rele(t);
+			return r;
+		}
+	}
+	return t;
+}
