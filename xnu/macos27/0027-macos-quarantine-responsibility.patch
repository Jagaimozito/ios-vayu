+/* a string into (size pointer, buffer): in, the buffer's size; out, the length with its NUL (0: none) */
+static int
+sweet_resp_putstr(user_addr_t sizep, user_addr_t buf, const char *str)
+{
+	uint64_t cap = 0, len = str ? strlen(str) + 1 : 0;
+	if (!sizep) {
+		return 0;
+	}
+	int e = copyin(sizep, &cap, sizeof(cap));
+	if (e) {
+		return e;
+	}
+	if (len > cap || !buf) {
+		len = 0;
+	}
+	if (len && (e = copyout(str, buf, (size_t)len))) {
+		return e;
+	}
+	return copyout(&len, sizep, sizeof(len));
+}
