+static int
+sweet_resp_attribution(proc_t r, const uint64_t *f)
+{
+	int e = 0;
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	vnode_t vp = proc_getexecutablevnode(r);
+	if (path && vp != NULLVP) {
+		int len = MAXPATHLEN;
+		if (vn_getpath(vp, path, &len) != 0) {
+			path[0] = 0;
+		}
+	}
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	uint8_t zero32[32] = { 0 };
+	uint32_t csflags = proc_getcsflags(r);
+	bool platform = csproc_get_platform_binary(r) != 0;
+	const char *ident = cs_identity_get(r), *team = csproc_get_teamid(r);
+	if (!e) e = sweet_resp_putstr(f[0x18 / 8], f[0x20 / 8], path && path[0] ? path : NULL);    /* binary path */
+	if (!e) e = sweet_resp_put64(f[0x28 / 8], 0);                                               /* binary offset */
+	if (!e) e = sweet_resp_putstr(f[0x30 / 8], f[0x38 / 8], team);                              /* team ID */
+	if (!e) e = sweet_resp_putstr(f[0x40 / 8], f[0x48 / 8], ident);                             /* signing ID */
+	if (!e && f[0x50 / 8]) e = copyout(zero32, f[0x50 / 8], 16);                                /* user UUID */
+	if (!e) e = sweet_resp_put64(f[0x58 / 8], platform ? 1 : 0);                                /* bit 0: platform */
+	if (!e) e = sweet_resp_putstr(f[0x60 / 8], f[0x68 / 8], NULL);                              /* entitlements: none */
+	if (!e) e = sweet_resp_putstr(f[0x70 / 8], f[0x78 / 8], NULL);                              /* hosted path */
+	if (!e && f[0x80 / 8]) e = copyout(zero32, f[0x80 / 8], 32);                                /* persistent ID */
+	if (!e) e = sweet_resp_put32(f[0x88 / 8], proc_platform(r));
+	if (!e) e = sweet_resp_put32(f[0x90 / 8], proc_sdk(r));
+	if (!e) e = sweet_resp_put64(f[0x98 / 8], csflags);
+	if (!e) e = sweet_resp_put32(f[0xa0 / 8], 0);
+	if (!e) e = sweet_resp_put64(f[0xa8 / 8], 0);
+	if (!e) e = sweet_resp_putstr(f[0xb0 / 8], f[0xb8 / 8], NULL);                              /* hosted team ID */
+	if (!e && f[0xc0 / 8]) {
+		uint8_t b = 0;
+		e = copyout(&b, f[0xc0 / 8], 1);
+	}
+	if (path) {
+		kfree_data(path, MAXPATHLEN);
+	}
+	return e;
+}
