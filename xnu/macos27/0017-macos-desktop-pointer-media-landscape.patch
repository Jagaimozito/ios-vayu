+/*
+ * The row pitch the pixels really have. macOS 27 (2026-11-22): WindowServer's 1440x3120 '&BGA' frames carry a
+ * surface-level bytesPerRow of 5760 (width * 4) but one plane whose bytesPerRow is 5888 (padded), and the GPU writes
+ * them at 5888. Reading at 5760 shifted every row 32 pixels further left: the panel showed the desktop sheared into
+ * near-horizontal streaks while the frame in memory was correct. A single-plane surface's plane pitch is the real one.
+ */
+static inline uint32_t
+sweet_fb_bpr(const SweetSurface *s)
+{
+#if XNU_TARGET_OS_OSX
+	if (s->planeCount == 1 && s->planes[0].bytesPerRow >= s->width * s->bytesPerElement) {
+		return s->planes[0].bytesPerRow;
+	}
+#endif
+	return s->bytesPerRow;
+}
