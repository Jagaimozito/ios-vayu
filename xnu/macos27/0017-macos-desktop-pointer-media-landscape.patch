+void
+SweetHIDPointer::point(IOFixed nx, IOFixed ny, int px, int py, bool down, bool was)
+{
+	/* 2026-11-22: the screen is turned by boot-arg sweetfb_rot (SweetFramebuffer.cpp, default 1): so is the pointer */
+	static int rot = -1;
+	if (rot < 0) {
+		uint32_t r = 1;
+		(void)PE_parse_boot_argn("sweetfb_rot", &r, sizeof(r));
+		rot = (r == 0 || r == 3) ? (int)r : 1;
+	}
+	const IOFixed one = 0x10000;
+	IOFixed rx = nx, ry = ny;
+	if (rot == 1) {
+		rx = ny;
+		ry = one - nx;
+	} else if (rot == 3) {
+		rx = one - ny;
+		ry = nx;
+	}
+	rx = rx < 0 ? 0 : (rx > one ? one : rx);
+	ry = ry < 0 ? 0 : (ry > one ? one : ry);
+	IOFixed x = fPixels ? (IOFixed)(px << 16) : rx;
+	IOFixed y = fPixels ? (IOFixed)(py << 16) : ry;
+	IOHIDEvent *event;
+	/*
+	 * 2026-11-22: a touch puts the pointer somewhere new and presses in the same instant. A mouse never does; the
+	 * press is sent as its own event after a move-only one, so the press is taken where the finger is.
+	 */
+	if (down && !was) {
+		event = IOHIDEvent::absolutePointerEvent(mach_absolute_time(), x, y, 0, 0, 0);
+		if (event) {
+			dispatchEvent(event);
+			event->release();
+		}
+	}
+	event = IOHIDEvent::absolutePointerEvent(mach_absolute_time(), x, y, 0, down ? 1 : 0, was ? 1 : 0);
+	if (event) {
+		dispatchEvent(event);
+		event->release();
+	}
+	static uint32_t logged;
+	if (down != was && logged < 40) {
+		logged++;
+		IOLog("SWEET HID: pointer %s at %d.%03d, %d.%03d (panel %d,%d)\n", down ? "down" : "up",
+		    x >> 16, (int)(((x & 0xffff) * 1000) >> 16), y >> 16, (int)(((y & 0xffff) * 1000) >> 16), px, py);
+	}
+}
