+/*
+ * SweetMedia: publish the SWEET root disk (bsd/dev/sweet_ufs.c, /dev/ufsroot0) in the I/O Registry as
+ * macOS storage does, a storage device with an IOMedia under it (2026-11-22, macOS 27 only).
+ *
+ * The root is a BSD block device the kernel makes directly; nothing in the IOStorage stack describes it. Disk
+ * Arbitration builds its disks from IOMedia objects, so it never knew the root: `diskutil info /` said "Could not
+ * find disk", the volume had no identity (vRefNum 0, no name), and LaunchServices asserted in
+ * LinkBinding::resolveBinding when Finder's sidebar asked for the root volume's icon (Finder crash-looped).
+ *
+ * These objects carry only what Disk Arbitration and CoreServices read (IOMedia keys, BSD name/major/minor/unit,
+ * the parent's Protocol Characteristics); no I/O goes through them. The class is named IOMedia because clients
+ * match on that class name; this kernel has no IOStorageFamily, so nothing else defines it. Published from a
+ * thread call shortly after the root device is made, so root mounting is untouched.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBSD.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSBoolean.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+
+#if XNU_TARGET_OS_OSX
+
+class SweetBlockStorage : public IOService {
+	OSDeclareDefaultStructors(SweetBlockStorage);
+};
+OSDefineMetaClassAndStructors(SweetBlockStorage, IOService);
+
+class IOMedia : public IOService {
+	OSDeclareDefaultStructors(IOMedia);
+};
+OSDefineMetaClassAndStructors(IOMedia, IOService);
+
+static struct {
+	char     name[32];
+	int      major, minor;
+	uint64_t bytes;
+	uint32_t blockSize;
+	bool     writable;
+} gSweetMediaArgs;
+static thread_call_t gSweetMediaCall;
+
+static void
+sweet_set_bool(IOService *s, const char *key, bool v)
+{
+	s->setProperty(key, v ? kOSBooleanTrue : kOSBooleanFalse);
+}
+
+static void
+sweet_media_publish_now(thread_call_param_t, thread_call_param_t)
+{
+	SweetBlockStorage *dev = OSTypeAlloc(SweetBlockStorage);
+	IOMedia *media = OSTypeAlloc(IOMedia);
+	if (!dev || !media || !dev->init() || !media->init()) {
+		IOLog("SWEET MEDIA: allocation failed\n");
+		OSSafeReleaseNULL(dev);
+		OSSafeReleaseNULL(media);
+		return;
+	}
+
+	/* The device: internal, like a Mac's built-in SSD (Disk Arbitration reads Protocol Characteristics). */
+	OSDictionary *proto = OSDictionary::withCapacity(2);
+	OSDictionary *chars = OSDictionary::withCapacity(3);
+	if (proto) {
+		OSString *ic = OSString::withCString("Apple Fabric");
+		OSString *loc = OSString::withCString("Internal");
+		proto->setObject("Physical Interconnect", ic);
+		proto->setObject("Physical Interconnect Location", loc);
+		OSSafeReleaseNULL(ic);
+		OSSafeReleaseNULL(loc);
+		dev->setProperty("Protocol Characteristics", proto);
+		proto->release();
+	}
+	if (chars) {
+		OSString *vendor = OSString::withCString("OnePlus");
+		OSString *product = OSString::withCString("Sweet UFS");
+		OSString *medium = OSString::withCString("Solid State");
+		chars->setObject("Vendor Name", vendor);
+		chars->setObject("Product Name", product);
+		chars->setObject("Medium Type", medium);
+		OSSafeReleaseNULL(vendor);
+		OSSafeReleaseNULL(product);
+		OSSafeReleaseNULL(medium);
+		dev->setProperty("Device Characteristics", chars);
+		chars->release();
+	}
+
+	/* The media: the whole disk, holding the HFS root (IOMedia.h keys). */
+	media->setProperty("Content", "Apple_HFS");
+	media->setProperty("Content Hint", "Apple_HFS");
+	media->setProperty("Base", 0ULL, 64);
+	media->setProperty("Size", gSweetMediaArgs.bytes, 64);
+	media->setProperty("Preferred Block Size", (unsigned long long)gSweetMediaArgs.blockSize, 64);
+	sweet_set_bool(media, "Whole", true);
+	sweet_set_bool(media, "Leaf", true);
+	sweet_set_bool(media, "Open", true);
+	sweet_set_bool(media, "Writable", gSweetMediaArgs.writable);
+	sweet_set_bool(media, "Removable", false);
+	sweet_set_bool(media, "Ejectable", false);
+	media->setProperty(kIOBSDNameKey, gSweetMediaArgs.name);
+	media->setProperty(kIOBSDMajorKey, (unsigned long long)gSweetMediaArgs.major, 32);
+	media->setProperty(kIOBSDMinorKey, (unsigned long long)gSweetMediaArgs.minor, 32);
+	media->setProperty(kIOBSDUnitKey, 0ULL, 32);
+
+	if (!dev->attach(IOService::getResourceService()) || !media->attach(dev)) {
+		IOLog("SWEET MEDIA: attach failed\n");
+		dev->release();
+		media->release();
+		return;
+	}
+	dev->registerService();
+	media->registerService();
+	IOLog("SWEET MEDIA: published IOMedia %s (major %d minor %d, %llu MiB, %u-byte blocks, %s)\n",
+	    gSweetMediaArgs.name, gSweetMediaArgs.major, gSweetMediaArgs.minor, gSweetMediaArgs.bytes >> 20,
+	    gSweetMediaArgs.blockSize, gSweetMediaArgs.writable ? "writable" : "read-only");
+	dev->release();         /* the registry holds them now */
+	media->release();
+}
+
+extern "C" void
+sweet_media_publish(const char *name, int major, int minor, uint64_t bytes, uint32_t blockSize, int writable)
+{
+	if (gSweetMediaCall) {
+		return;
+	}
+	strlcpy(gSweetMediaArgs.name, name, sizeof(gSweetMediaArgs.name));
+	gSweetMediaArgs.major = major;
+	gSweetMediaArgs.minor = minor;
+	gSweetMediaArgs.bytes = bytes;
+	gSweetMediaArgs.blockSize = blockSize;
+	gSweetMediaArgs.writable = writable != 0;
+	gSweetMediaCall = thread_call_allocate(sweet_media_publish_now, NULL);
+	if (gSweetMediaCall) {
+		uint64_t deadline;
+		clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);   /* after the root is mounted */
+		thread_call_enter_delayed(gSweetMediaCall, deadline);
+	}
+}
+
+#else /* !XNU_TARGET_OS_OSX */
+
+extern "C" void
+sweet_media_publish(const char *, int, int, uint64_t, uint32_t, int)
+{
+}
+
+#endif /* XNU_TARGET_OS_OSX */
