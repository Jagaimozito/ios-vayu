+/*
+ * IOConnectGetService: IOUserClient's default answers none (kIOReturnUnsupported). IOKit's IOHIDCopyCFTypeParameter
+ * needs the IOHIDSystem behind the connection to read HIDParameters from the registry; without it it went straight
+ * to the com.apple.iohideventsystem request that deadlocks WindowServer (IOHIDFamily's user clients return the owner).
+ */
+IOService *
+SweetHIDSystemUserClient::getService(void)
+{
+	return fOwner;
+}
