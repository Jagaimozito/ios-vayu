+#define SWEET_PSR_N (1u << 31)
+#define SWEET_PSR_Z (1u << 30)
+#define SWEET_PSR_C (1u << 29)
+#define SWEET_PSR_V (1u << 28)
+
+static inline uint64_t
+sweet_ror64(uint64_t x, unsigned n)
+{
+	return (x >> n) | (x << (64 - n));
+}
+
+static inline uint64_t
+sweet_sha512_big0(uint64_t x)
+{
+	return sweet_ror64(x, 28) ^ sweet_ror64(x, 34) ^ sweet_ror64(x, 39);
+}
+
+static inline uint64_t
+sweet_sha512_big1(uint64_t x)
+{
+	return sweet_ror64(x, 14) ^ sweet_ror64(x, 18) ^ sweet_ror64(x, 41);
+}
+
+static inline uint64_t
+sweet_sha512_small0(uint64_t x)
+{
+	return sweet_ror64(x, 1) ^ sweet_ror64(x, 8) ^ (x >> 7);
+}
+
+static inline uint64_t
+sweet_sha512_small1(uint64_t x)
+{
+	return sweet_ror64(x, 19) ^ sweet_ror64(x, 61) ^ (x >> 6);
+}
+
+/* Integer-only implementation of FRINT{32,64}{Z,X}; keep this trap path general-register-only. */
+static uint64_t
+sweet_frintn(uint64_t bits, bool is_double, unsigned intsize, unsigned rounding, uint32_t *fpsr)
+{
+	unsigned fracbits = is_double ? 52 : 23;
+	unsigned expbits = is_double ? 11 : 8;
+	int bias = is_double ? 1023 : 127;
+	uint64_t fracmask = (1ull << fracbits) - 1;
+	uint64_t expmask = (1ull << expbits) - 1;
+	bool sign = (bits >> (fracbits + expbits)) != 0;
+	uint64_t exp = (bits >> fracbits) & expmask;
+	uint64_t frac = bits & fracmask;
+	uint64_t q = 0, rem = 0;
+	unsigned shift = 0;
+	bool inexact = false;
+	if (exp == expmask) {
+		*fpsr |= 1u;            /* IOC: NaN or infinity */
+		goto minint;
+	}
+	if (exp == 0 && frac == 0) {
+		return bits;            /* preserve signed zero */
+	}
+	int e = (exp ? (int)exp - bias : 1 - bias);
+	uint64_t sig = (exp ? (1ull << fracbits) : 0) | frac;
+	if (e < 0) {
+		q = 0;
+		rem = sig;
+		shift = (unsigned)(fracbits - e);
+	} else if ((unsigned)e >= fracbits) {
+		if ((unsigned)e >= intsize) {
+			goto minint;
+		}
+		if ((unsigned)e == intsize - 1 && (!sign || frac != 0)) {
+			goto minint;
+		}
+		q = sig << ((unsigned)e - fracbits);
+	} else {
+		shift = fracbits - (unsigned)e;
+		q = sig >> shift;
+		rem = sig & ((1ull << shift) - 1);
+	}
+	inexact = rem != 0;
+	if (inexact) {
+		bool increment = false;
+		if (rounding == 1) {           /* +infinity */
+			increment = !sign;
+		} else if (rounding == 2) {    /* -infinity */
+			increment = sign;
+		} else if (rounding == 0 && shift != 0 && shift < 64) { /* nearest, ties to even */
+			uint64_t half = 1ull << (shift - 1);
+			increment = rem > half || (rem == half && (q & 1));
+		}
+		if (increment) {
+			q++;
+		}
+	}
+	if (q > (sign ? (1ull << (intsize - 1)) : ((1ull << (intsize - 1)) - 1))) {
+		goto minint;
+	}
+	if (inexact) {
+		*fpsr |= 1u << 4;      /* IXC */
+	}
+	{
+		uint64_t mag = q;
+		uint64_t minint = sign ? (uint64_t)(0 - mag) : mag;
+		if (mag == 0) {
+			return sign ? (1ull << (fracbits + expbits)) : 0;
+		}
+		unsigned top = 63u - (unsigned)__builtin_clzll(mag);
+		uint64_t encoded_sig;
+		if (top <= fracbits) {
+			encoded_sig = mag << (fracbits - top);
+		} else {
+			unsigned drop = top - fracbits;
+			encoded_sig = mag >> drop;
+		}
+		uint64_t encoded_exp = (uint64_t)(top + bias) << fracbits;
+		return (sign ? (1ull << (fracbits + expbits)) : 0) | encoded_exp | (encoded_sig & fracmask);
+	}
+minint:
+	*fpsr |= 1u;
+	if (intsize == 32) {
+		return is_double ? 0xc1e0000000000000ull : 0xcf000000u; /* -2^31 */
+	}
+	return is_double ? 0xc3e0000000000000ull : 0xdf000000u; /* -2^63 */
+}
+
+/* FHM is absent on SM8150, but the scalar half->single conversion and single FMA are baseline ARMv8 FP ops. */
+static inline uint32_t
+sweet_fma_half(uint16_t a, uint16_t b, uint32_t acc, bool subtract, uint32_t fpcr, uint32_t *fpsr)
+{
+	uint32_t result = acc;
+	uint64_t status = 0, host_fpcr = 0, host_fpsr = 0;
+	__asm__ volatile("mrs %0, FPCR\n\tmrs %1, FPSR" : "=r"(host_fpcr), "=r"(host_fpsr));
+	__asm__ volatile("msr FPCR, %0\n\tmsr FPSR, %1" :: "r"((uint64_t)fpcr), "r"((uint64_t)*fpsr) : "memory");
+	if (subtract) {
+		__asm__ volatile(
+		    "fmov h0, %w2\n\tfcvt s0, h0\n\tfmov h1, %w3\n\tfcvt s1, h1\n\t"
+		    "fmov s2, %w0\n\tfmsub s2, s0, s1, s2\n\tfmov %w0, s2\n\tmrs %1, FPSR"
+		    : "+r"(result), "=r"(status) : "r"((uint32_t)a), "r"((uint32_t)b)
+		    : "v0", "v1", "v2", "memory");
+	} else {
+		__asm__ volatile(
+		    "fmov h0, %w2\n\tfcvt s0, h0\n\tfmov h1, %w3\n\tfcvt s1, h1\n\t"
+		    "fmov s2, %w0\n\tfmadd s2, s0, s1, s2\n\tfmov %w0, s2\n\tmrs %1, FPSR"
+		    : "+r"(result), "=r"(status) : "r"((uint32_t)a), "r"((uint32_t)b)
+		    : "v0", "v1", "v2", "memory");
+	}
+	__asm__ volatile("msr FPCR, %0\n\tmsr FPSR, %1" :: "r"(host_fpcr), "r"(host_fpsr) : "memory");
+	*fpsr = (uint32_t)status;
+	return result;
+}
+
+static bool
+sweet_emulate_user(arm_saved_state_t *state, arm_neon_saved_state_t *neon, uint32_t instr)
+{
+	uint32_t cpsr = saved_state64(state)->cpsr;
+	arm_neon_saved_state64_t *vstate = (neon != NULL && is_neon_saved_state64(neon)) ? neon_state64(neon) : NULL;
+	int emul_kind = 0;
+
+	/* FEAT_SHA3: 128-bit logical operations. The exception context's NEON image is restored by locore on EL0 return. */
+	if (vstate != NULL && (instr & 0xffc08000) == 0xce000000) {
+		unsigned rd = instr & 31, rn = (instr >> 5) & 31, ra = (instr >> 10) & 31, rm = (instr >> 16) & 31;
+		uint64_t *d = (uint64_t *)&vstate->v.q[rd];
+		const uint64_t *n = (const uint64_t *)&vstate->v.q[rn];
+		const uint64_t *a = (const uint64_t *)&vstate->v.q[ra];
+		const uint64_t *m = (const uint64_t *)&vstate->v.q[rm];
+		uint64_t lo, hi;
+		if (instr & (1u << 21)) { /* BCAX: Vn XOR (Vm AND NOT(Va)). */
+			lo = n[0] ^ (m[0] & ~a[0]);
+			hi = n[1] ^ (m[1] & ~a[1]);
+			sweet_emul_note("BCAX", state, instr);
+			emul_kind = SWEET_EMUL_BCAX;
+		} else {
+			lo = n[0] ^ m[0] ^ a[0];
+			hi = n[1] ^ m[1] ^ a[1];
+			sweet_emul_note("EOR3", state, instr);
+			emul_kind = SWEET_EMUL_EOR3;
+		}
+		d[0] = lo; d[1] = hi;
+		goto done;
+	}
+	if (vstate != NULL && (instr & 0xffe00000) == 0xce800000) { /* XAR */
+		unsigned rd = instr & 31, rn = (instr >> 5) & 31, rot = (instr >> 10) & 63, rm = (instr >> 16) & 31;
+		uint64_t *d = (uint64_t *)&vstate->v.q[rd];
+		const uint64_t *n = (const uint64_t *)&vstate->v.q[rn];
+		const uint64_t *m = (const uint64_t *)&vstate->v.q[rm];
+		d[0] = rot ? sweet_ror64(n[0] ^ m[0], rot) : (n[0] ^ m[0]);
+		d[1] = rot ? sweet_ror64(n[1] ^ m[1], rot) : (n[1] ^ m[1]);
+		sweet_emul_note("XAR", state, instr);
+		emul_kind = SWEET_EMUL_XAR;
+		goto done;
+	}
+	if (vstate != NULL && (instr & 0xffe0f000) == 0xce608000) { /* SHA512H/H2/SU1; SHA3 RAX1 */
+		unsigned rd = instr & 31, rn = (instr >> 5) & 31, op = (instr >> 10) & 3, rm = (instr >> 16) & 31;
+		uint64_t *d = (uint64_t *)&vstate->v.q[rd];
+		const uint64_t *n = (const uint64_t *)&vstate->v.q[rn];
+		const uint64_t *m = (const uint64_t *)&vstate->v.q[rm];
+		uint64_t d0 = d[0], d1 = d[1];
+		switch (op) {
+		case 0: /* SHA512H */
+			d1 += sweet_sha512_big1(m[1]) + ((m[1] & n[0]) ^ (~m[1] & n[1]));
+			d0 += sweet_sha512_big1(d1 + m[0]) + (((d1 + m[0]) & m[1]) ^ (~(d1 + m[0]) & n[0]));
+			sweet_emul_note("SHA512H", state, instr); emul_kind = SWEET_EMUL_SHA512H; break;
+		case 1: /* SHA512H2 */
+			d1 += sweet_sha512_big0(m[0]) + ((n[0] & m[1]) | ((n[0] | m[1]) & m[0]));
+			d0 += sweet_sha512_big0(d1) + ((d1 & m[0]) | ((d1 | m[0]) & m[1]));
+			sweet_emul_note("SHA512H2", state, instr); emul_kind = SWEET_EMUL_SHA512H2; break;
+		case 2: /* SHA512SU1 */
+			d0 += sweet_sha512_small1(n[0]) + m[0];
+			d1 += sweet_sha512_small1(n[1]) + m[1];
+			sweet_emul_note("SHA512SU1", state, instr); emul_kind = SWEET_EMUL_SHA512SU1; break;
+		case 3: /* RAX1 */
+			d0 = n[0] + sweet_ror64(m[0], 1);
+			d1 = n[1] + sweet_ror64(m[1], 1);
+			sweet_emul_note("RAX1", state, instr); emul_kind = SWEET_EMUL_RAX1; break;
+		}
+		d[0] = d0; d[1] = d1;
+		goto done;
+	}
+	if (vstate != NULL && (instr & 0xfffffc00) == 0xcec08000) { /* SHA512SU0 */
+		unsigned rd = instr & 31, rn = (instr >> 5) & 31;
+		uint64_t *d = (uint64_t *)&vstate->v.q[rd];
+		const uint64_t *n = (const uint64_t *)&vstate->v.q[rn];
+		d[0] += sweet_sha512_small0(d[1]);
+		d[1] += sweet_sha512_small0(n[0]);
+		sweet_emul_note("SHA512SU0", state, instr);
+		emul_kind = SWEET_EMUL_SHA512SU0;
+		goto done;
+	}
+	if (vstate != NULL && (instr & 0xff207c00) == 0x1e204000) { /* scalar FRINT32/64 Z/X */
+		unsigned op = (instr >> 15) & 0x3f;
+		if (op >= 0x10 && op <= 0x13) {
+			unsigned rn = (instr >> 5) & 31, rd = instr & 31;
+			bool is_double = ((instr >> 22) & 3) == 1;
+			bool is32 = op < 0x12;
+			bool z = !(op & 1);
+			unsigned width = is32 ? 32 : 64;
+			uint64_t *src = (uint64_t *)&vstate->v.q[rn];
+			uint64_t *dst = (uint64_t *)&vstate->v.q[rd];
+			uint64_t in = is_double ? src[0] : (uint32_t)src[0];
+			unsigned rmode = z ? 3 : ((vstate->fpcr >> 22) & 3);
+			uint64_t out = sweet_frintn(in, is_double, width, rmode, &vstate->fpsr);
+			dst[0] = is_double ? out : (uint32_t)out;
+			dst[1] = 0;
