+static inline uint64_t
+sweet_xreg(arm_saved_state_t *state, unsigned r, bool sp_for_31)
+{
+	if (r == 31) {
+		return sp_for_31 ? saved_state64(state)->sp : 0;
+	}
+	return saved_state64(state)->x[r];
+}
+
+static inline void
+sweet_set_xreg(arm_saved_state_t *state, unsigned r, uint64_t v)
+{
+	if (r != 31) {
+		saved_state64(state)->x[r] = v;
+	}
