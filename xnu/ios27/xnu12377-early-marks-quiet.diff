 }
 
+/*
+ * 2026-11-23: the progress markers (a coloured block per stage along the bottom edge and a "SWEET EARLY n" line)
+ * stay off the screen unless the kernel is built with SWEET_EARLY_VERBOSE: the boot menu's boot picture shows until
+ * the GUI draws. An early panic still prints (sweet_early_panic).
+ */
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
+#if !defined(SWEET_EARLY_VERBOSE)
+	(void)stage;
+	(void)label;
+	return;
+#endif
 	if (early_disabled || stage > 20) {
 		return;
 	}
