+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/sysctl.h>
+/* syscall failure tracer (see unix_syscall): process name, everyday errors too, lines left */
+static char sweet_st_name[MAXCOMLEN + 1];
+static int sweet_st_state;      /* 0 boot-arg not read yet */
+static int sweet_st_all;
+static int sweet_st_left = 600;
+SYSCTL_STRING(_kern, OID_AUTO, sweet_systrace, CTLFLAG_RW | CTLFLAG_LOCKED, sweet_st_name, sizeof(sweet_st_name),
+    "log failing syscalls of processes whose name contains this (empty: off)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_systrace_all, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_st_all, 0,
+    "1: also log ENOENT, ESRCH, EEXIST, ERANGE");
+SYSCTL_INT(_kern, OID_AUTO, sweet_systrace_left, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_st_left, 0,
+    "syscall failure lines still to log");
+#endif
+
 #if CONFIG_DTRACE
 extern int32_t dtrace_systrace_syscall(struct proc *, void *, int *);
 extern void dtrace_systrace_syscall_return(unsigned short, int, int *);
