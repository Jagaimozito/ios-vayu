+// command buffer completed or went, so a buffer object that goes is named by nothing the GPU still runs. A buffer whose GPU address
+// was handed out is never kept (an argument buffer names it without own:), nor one the app made purgeable or aliasable, nor a heap,
+// no-copy or surface buffer (none of them is made by newBufferWithBytes: anyway). At most kUploadPoolPerSize buffers of one kind and
+// kUploadPoolBytes in all; everything kept goes back at memory pressure. /var/local/sweet-nobufpool turns it off (read once).
+static const uint64_t kUploadPoolMaxLength=64*1024,kUploadPoolBytes=8u<<20;
+static const size_t kUploadPoolPerSize=64;
+struct PooledUpload {NmbBuffer *handle;void *contents;};
