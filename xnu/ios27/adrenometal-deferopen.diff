+/// How far [`passes_after_an_end_in_flight_open_without_waiting_and_keep_their_order`]'s
+/// encoding thread got: a pass drawn (opened, its calls made), a pass ended, or all of them.
+#[derive(Debug)]
+#[allow(dead_code)] // the passes' numbers are read through `Debug`, in the failure message
+enum Stage {
+    Drawn(usize),
+    Ended(usize),
+    Done,
+}
+
+/// Wait for [`Stage::Done`], each stage within [`WAIT`]: `Err` with the last stage reached (or
+/// `None`) where one did not come.
+fn until_done(passes: &mpsc::Receiver<Stage>) -> Result<(), Option<Stage>> {
+    let mut last = None;
+    loop {
+        match passes.recv_timeout(WAIT) {
+            Ok(Stage::Done) => return Ok(()),
+            Ok(stage) => last = Some(stage),
+            Err(_) => return Err(last),
+        }
+    }
+}
