+/// A pass over `target` that draws the rectangle in `color`: the first clears the target, the
+/// others load what the passes before left.
+fn color_pass(
+    command_buffer: &CommandBuffer,
+    state: &RenderPipelineState,
+    target: &Texture,
+    color: [f32; 4],
+    first: bool,
+) -> RenderCommandEncoder {
+    let mut descriptor = pass(target);
+    if !first {
+        descriptor.color_attachments[0].load_action = crate::LoadAction::Load;
+    }
+    let mut encoder = command_buffer.render_command_encoder(&descriptor).unwrap();
+    rectangle(state, &mut encoder);
+    encoder
+        .set_fragment_bytes(&bytes_of(&color, f32::to_le_bytes), 0)
+        .unwrap();
+    encoder
+        .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+        .unwrap();
+    encoder
+}
