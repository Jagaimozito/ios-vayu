+/// ios-sweet 0044: render encoders asked after a render encoder whose end is in flight open their
+/// passes on the lowering thread, after that end. With the first pass's lowering held (Worker),
+/// three more passes open, draw and end without waiting for it (four ends in flight, the
+/// lowering thread's cap); then two more, a copy back and the commit; every pass ran, in order:
+/// the target holds the last pass's color, under both policies. None of the openings ran out of
+/// the order asked, and under Worker the openings after an end in flight were left to the thread.
+#[test]
+fn passes_after_an_end_in_flight_open_without_waiting_and_keep_their_order() {
+    let scratch = Scratch::new("deferred-open-order");
+    for policy in POLICIES {
+        let device = device(&scratch.0, policy, &[], &Heard::default());
+        let before = crate::deferred_open_counts();
+        let (opened, open) = mpsc::channel();
+        let (go, going) = mpsc::channel::<()>();
+        let (passed, passes) = mpsc::channel();
+        let encoding = std::thread::spawn({
+            let device = device.clone();
+            move || {
+                let state = rectangle_state(&device);
+                let queue = device.new_command_queue().unwrap();
+                let command_buffer = queue.command_buffer().unwrap();
+                let target = target(&device);
+                let first = color_pass(&command_buffer, &state, &target, PASS_COLORS[0], true);
+                opened.send(()).unwrap();
+                going.recv().unwrap();
+                first.end_encoding().unwrap();
+                passed.send(Stage::Ended(0)).unwrap();
+                for (at, &color) in PASS_COLORS[1..4].iter().enumerate() {
+                    let encoder = color_pass(&command_buffer, &state, &target, color, false);
+                    passed.send(Stage::Drawn(at + 1)).unwrap();
+                    encoder.end_encoding().unwrap();
+                    passed.send(Stage::Ended(at + 1)).unwrap();
+                }
+                passed.send(Stage::Done).unwrap();
+                for &color in &PASS_COLORS[4..] {
+                    color_pass(&command_buffer, &state, &target, color, false)
+                        .end_encoding()
+                        .unwrap();
+                }
+                let back = copy_back(&device, &command_buffer, &target);
+                committed(&command_buffer, &back)
+            }
+        });
+        open.recv().unwrap();
+        let returned = match policy {
+            RenderLoweringPolicy::Worker => {
+                let slots = device.shared().deferred.taken();
+                let [slot] = &slots[..] else {
+                    panic!("{} encoders' slots taken, not one", slots.len());
+                };
+                slot.while_held(|| {
+                    go.send(()).unwrap();
+                    until_done(&passes)
+                })
+            }
+            _ => {
+                go.send(()).unwrap();
+                until_done(&passes)
+            }
+        };
+        assert!(
+            returned.is_ok(),
+            "{policy:?}: the encoding thread stopped after {:?} while the first pass's lowering was \
+             held; deferred-open counts {:?} (at the test's start {before:?})",
+            returned.err(),
+            crate::deferred_open_counts()
+        );
+        let words = encoding.join().unwrap();
+        let last = packed(PASS_COLORS[PASS_COLORS.len() - 1]);
+        assert!(
+            words.iter().all(|&word| word == last),
+            "{policy:?}: {:x?}, not {last:x}",
+            &words[..4]
+        );
+        let after = crate::deferred_open_counts();
+        assert_eq!(
+            after[3], 0,
+            "{policy:?}: an opening ran out of order: {after:?}"
+        );
+        assert_eq!(
+            after[4], before[4],
+            "{policy:?}: an opening was refused: {after:?}"
+        );
+        if policy == RenderLoweringPolicy::Worker {
+            assert!(
+                after[0] > before[0],
+                "{policy:?}: no opening was deferred: {after:?}"
+            );
+        }
+    }
+}
