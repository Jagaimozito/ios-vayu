+
+impl PendingOpen {
+    pub(crate) fn new(
+        before: EndInFlight,
+        command_buffer: CommandBuffer,
+        descriptor: RenderPassDescriptor,
+        ticket: u64,
+    ) -> PendingOpen {
+        PendingOpen {
+            before: Some(before),
+            command_buffer,
+            descriptor: Box::new(descriptor),
+            ticket,
+        }
+    }
