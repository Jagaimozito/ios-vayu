+    /// or the command buffer failed with the opening's refusal.
+    fn ready(&mut self, by_thread: bool) {
+        let Some(pending) = self.opening.take() else {
+            return;
+        };
+        let PendingOpen {
+            before,
+            command_buffer,
+            descriptor,
+            ticket,
+        } = pending;
+        // Lowered already where this is the lowering thread, which took the slot before this one.
+        if let Some(before) = before {
+            before.finish();
+        }
+        let counts = &DEFERRED_OPEN_COUNTS;
+        counts[if by_thread { 1 } else { 2 }].fetch_add(1, Ordering::Relaxed);
