+/// The runtime's deferred render pass openings (ios-sweet bridge patch 0044, `render/deferral.rs`), into the caller's five words:
+/// left to the lowering thread at their calls, run by that thread, run on the program's thread, run out of the order the program
+/// asked (the ordering check: always 0 unless the hand-off is wrong), refused as they ran.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_deferred_open_counts(out: *mut u64) -> bool {
+    if out.is_null() {
+        return false;
+    }
+    let counts = metal2vulkan_runtime::deferred_open_counts();
+    // SAFETY: the header's five words.
+    unsafe { std::ptr::copy_nonoverlapping(counts.as_ptr(), out, counts.len()) };
+    true
+}
