+static void
+sweet_surface_use_add(SweetSurface *s, uint32_t category, int32_t delta)
+{
+	if (s == NULL || s->state == NULL || category > 1) {
+		return;
+	}
+	volatile SInt32 *c = (volatile SInt32 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE + 4 * category);
