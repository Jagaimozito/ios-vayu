+IOSurfaceRootUserClient::useCount(uint32_t id, uint32_t category, int32_t delta)
 {
+	if (category > 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(id, NULL);
+	if (ref == NULL || (delta < 0 && ref->use[category] == 0)) {
+		IOLockUnlock(fLock);
+		sweet_surf_log_once(delta > 0 ? "use+ (no surface)" : "use- (none held)", (delta > 0 ? 40 : 42) + category);
+		return ref == NULL ? kIOReturnNotFound : kIOReturnSuccess;
+	}
+	ref->use[category] += delta;
+	sweet_surface_use_add(ref->surface, category, delta);
+	IOLockUnlock(fLock);
 	return kIOReturnSuccess;
 }
 
+/* trap 0: IOSurfaceIncrementUseCount(ForCategory), trap 1: Decrement (id, category) */
+IOReturn
+IOSurfaceRootUserClient::trapUseCount(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseDecrement(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, -1);
+}
